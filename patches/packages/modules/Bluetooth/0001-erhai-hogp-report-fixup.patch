+TEST(HogpReportFixupTest, FixesExact512ByteReportTo561) {
+  auto result = FixErhaiHogpReport(kErhaiVendorId, kErhaiProductId, kExpected512, sizeof(kExpected512));
+  ASSERT_TRUE(result.has_value());
+  EXPECT_EQ(result->size(), 561u);
+  EXPECT_EQ(0, std::memcmp(result->data(), kExpected512, 512));
+  EXPECT_EQ(0, std::memcmp(result->data() + 512, kTail49, 49));
+}
+
+TEST(HogpReportFixupTest, IdempotentWhenAlready561Bytes) {
+  std::vector<uint8_t> complete561;
+  complete561.insert(complete561.end(), kExpected512, kExpected512 + 512);
+  complete561.insert(complete561.end(), kTail49, kTail49 + 49);
+
+  auto result = FixErhaiHogpReport(kErhaiVendorId, kErhaiProductId, complete561.data(), complete561.size());
+  EXPECT_FALSE(result.has_value());
+}
+
+TEST(HogpReportFixupTest, RejectsNullPointer) {
+  auto result = FixErhaiHogpReport(kErhaiVendorId, kErhaiProductId, nullptr, 512);
+  EXPECT_FALSE(result.has_value());
+}
+
+TEST(HogpReportFixupTest, RejectsWrongVendorId) {
+  auto result = FixErhaiHogpReport(0x1234, kErhaiProductId, kExpected512, sizeof(kExpected512));
+  EXPECT_FALSE(result.has_value());
+}
+
+TEST(HogpReportFixupTest, RejectsWrongProductId) {
+  auto result = FixErhaiHogpReport(kErhaiVendorId, 0x5678, kExpected512, sizeof(kExpected512));
+  EXPECT_FALSE(result.has_value());
+}
+
+TEST(HogpReportFixupTest, RejectsZeroSize) {
+  auto result = FixErhaiHogpReport(kErhaiVendorId, kErhaiProductId, kExpected512, 0);
+  EXPECT_FALSE(result.has_value());
+}
+
+TEST(HogpReportFixupTest, Rejects511Bytes) {
+  auto result = FixErhaiHogpReport(kErhaiVendorId, kErhaiProductId, kExpected512, 511);
+  EXPECT_FALSE(result.has_value());
+}
+
+TEST(HogpReportFixupTest, Rejects513Bytes) {
+  std::vector<uint8_t> data513(kExpected512, kExpected512 + 512);
+  data513.push_back(0x00);
+  auto result = FixErhaiHogpReport(kErhaiVendorId, kErhaiProductId, data513.data(), data513.size());
+  EXPECT_FALSE(result.has_value());
+}
+
+TEST(HogpReportFixupTest, RejectsModifiedByteIn512Sample) {
+  std::vector<uint8_t> modified(kExpected512, kExpected512 + 512);
+  // Modify one byte
+  modified[100] ^= 0xff;
+  auto result = FixErhaiHogpReport(kErhaiVendorId, kErhaiProductId, modified.data(), modified.size());
+  EXPECT_FALSE(result.has_value());
+}
+
+TEST(HogpReportFixupTest, RejectsArbitrary561Bytes) {
+  std::vector<uint8_t> arbitrary561(561, 0xaa);
+  auto result = FixErhaiHogpReport(kErhaiVendorId, kErhaiProductId, arbitrary561.data(), arbitrary561.size());
+  EXPECT_FALSE(result.has_value());
+}
