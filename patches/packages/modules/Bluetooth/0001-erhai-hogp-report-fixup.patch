+TEST_F(BtaHhTest, bta_hh_le_save_report_map__erhai_keyboard_fixed) {
+  tBTA_HH_DEV_CB dev_cb = {};
+  dev_cb.dscp_info.vendor_id = 0x22d9;
+  dev_cb.dscp_info.product_id = 0x3869;
+
+  test::mock::device_interop::interop_match_vendor_product_ids.body =
+          [](const interop_feature_t feature, uint16_t vendor_id, uint16_t product_id) {
+            return (feature == INTEROP_HOGP_LONG_REPORT && vendor_id == 0x22d9 && product_id == 0x3869);
+          };
+
+  uint8_t desc[512];
+  memcpy(desc, kErhaiSample512, 512);
+
+  bta_hh_le_save_report_map(&dev_cb, 512, desc);
+
+  EXPECT_EQ(dev_cb.hid_srvc.descriptor.dl_len, 561);
+  ASSERT_NE(dev_cb.hid_srvc.rpt_map, nullptr);
+  EXPECT_EQ(0, memcmp(dev_cb.hid_srvc.rpt_map, kErhaiSample512, 512));
+  EXPECT_EQ(0, memcmp(dev_cb.hid_srvc.rpt_map + 512, kErhaiTail49, 49));
+
+  osi_free_and_reset((void**)&dev_cb.hid_srvc.rpt_map);
+  test::mock::device_interop::interop_match_vendor_product_ids = {};
+}
+
+TEST_F(BtaHhTest, bta_hh_le_save_report_map__erhai_keyboard_fingerprint_mismatch) {
+  tBTA_HH_DEV_CB dev_cb = {};
+  dev_cb.dscp_info.vendor_id = 0x22d9;
+  dev_cb.dscp_info.product_id = 0x3869;
+
+  test::mock::device_interop::interop_match_vendor_product_ids.body =
+          [](const interop_feature_t feature, uint16_t vendor_id, uint16_t product_id) {
+            return (feature == INTEROP_HOGP_LONG_REPORT && vendor_id == 0x22d9 && product_id == 0x3869);
+          };
+
+  uint8_t desc[512];
+  memcpy(desc, kErhaiSample512, 512);
+  desc[10] ^= 0xff;  // Corrupt a byte
+
+  bta_hh_le_save_report_map(&dev_cb, 512, desc);
+
+  // Mismatch must not fall into Brydge; must remain verbatim 512 bytes
+  EXPECT_EQ(dev_cb.hid_srvc.descriptor.dl_len, 512);
+  ASSERT_NE(dev_cb.hid_srvc.rpt_map, nullptr);
+  EXPECT_EQ(0, memcmp(dev_cb.hid_srvc.rpt_map, desc, 512));
+
+  osi_free_and_reset((void**)&dev_cb.hid_srvc.rpt_map);
+  test::mock::device_interop::interop_match_vendor_product_ids = {};
+}
+
+TEST_F(BtaHhTest, bta_hh_le_save_report_map__brydge_behavior_preserved) {
+  tBTA_HH_DEV_CB dev_cb = {};
+  dev_cb.dscp_info.vendor_id = 0x03f6;
+  dev_cb.dscp_info.product_id = 0xa001;
+
+  test::mock::device_interop::interop_match_vendor_product_ids.body =
+          [](const interop_feature_t feature, uint16_t vendor_id, uint16_t product_id) {
+            return (feature == INTEROP_HOGP_LONG_REPORT && vendor_id == 0x03f6 && product_id == 0xa001);
+          };
+
+  uint8_t desc[512] = {0};
+
+  bta_hh_le_save_report_map(&dev_cb, 512, desc);
+
+  // Brydge residual report map is 93 bytes; 512 + 93 = 605
+  EXPECT_EQ(dev_cb.hid_srvc.descriptor.dl_len, 605);
+  ASSERT_NE(dev_cb.hid_srvc.rpt_map, nullptr);
+
+  osi_free_and_reset((void**)&dev_cb.hid_srvc.rpt_map);
+  test::mock::device_interop::interop_match_vendor_product_ids = {};
+}
