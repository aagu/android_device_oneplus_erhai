+// Mock storage loading simulation matching btif_storage_load_bonded_hogp_device logic
+struct MockHogpDescriptorLoader {
+  uint16_t vendor_id;
+  uint16_t product_id;
+  std::vector<uint8_t> stored_bin;
+
+  struct Result {
+    uint16_t dl_len;
+    std::vector<uint8_t> dsc_list;
+  };
+
+  Result Load() {
+    Result res;
+    size_t len = stored_bin.size();
+    if (len > 0) {
+      uint8_t* raw_dsc = (uint8_t*)alloca(len);
+      memcpy(raw_dsc, stored_bin.data(), len);
+
+      auto fixed = bluetooth::device::FixErhaiHogpReport(vendor_id, product_id, raw_dsc, len);
+      if (fixed.has_value()) {
+        len = fixed->size();
+        res.dl_len = static_cast<uint16_t>(len);
+        res.dsc_list.resize(len);
+        memcpy(res.dsc_list.data(), fixed->data(), len);
+      } else {
+        res.dl_len = static_cast<uint16_t>(len);
+        res.dsc_list.resize(len);
+        memcpy(res.dsc_list.data(), raw_dsc, len);
+      }
+    } else {
+      res.dl_len = 0;
+    }
+    return res;
+  }
+};
+
+TEST(ErhaiHogpStorageTest, Cached512ByteReportRepairedTo561) {
+  MockHogpDescriptorLoader loader;
+  loader.vendor_id = 0x22d9;
+  loader.product_id = 0x3869;
+  loader.stored_bin.assign(kErhaiSample512, kErhaiSample512 + 512);
+
+  auto res = loader.Load();
+  EXPECT_EQ(res.dl_len, 561);
+  ASSERT_EQ(res.dsc_list.size(), 561u);
+  EXPECT_EQ(0, memcmp(res.dsc_list.data(), kErhaiSample512, 512));
+  EXPECT_EQ(0, memcmp(res.dsc_list.data() + 512, kErhaiTail49, 49));
+}
+
+TEST(ErhaiHogpStorageTest, Cached561ByteReportRemains561Idempotent) {
+  MockHogpDescriptorLoader loader;
+  loader.vendor_id = 0x22d9;
+  loader.product_id = 0x3869;
+  loader.stored_bin.assign(kErhaiSample512, kErhaiSample512 + 512);
+  loader.stored_bin.insert(loader.stored_bin.end(), kErhaiTail49, kErhaiTail49 + 49);
+
+  auto res = loader.Load();
+  EXPECT_EQ(res.dl_len, 561);
+  ASSERT_EQ(res.dsc_list.size(), 561u);
+  EXPECT_EQ(0, memcmp(res.dsc_list.data(), loader.stored_bin.data(), 561));
+}
+
+TEST(ErhaiHogpStorageTest, UnknownDeviceCacheNotTruncatedOrModified) {
+  MockHogpDescriptorLoader loader;
+  loader.vendor_id = 0x1234;
+  loader.product_id = 0x5678;
+  std::vector<uint8_t> arbitrary(300, 0x42);
+  loader.stored_bin = arbitrary;
+
+  auto res = loader.Load();
+  EXPECT_EQ(res.dl_len, 300);
+  ASSERT_EQ(res.dsc_list.size(), 300u);
+  EXPECT_EQ(0, memcmp(res.dsc_list.data(), arbitrary.data(), 300));
+}
+
+TEST(ErhaiHogpStorageTest, CorruptedErhaiCacheNotModified) {
+  MockHogpDescriptorLoader loader;
+  loader.vendor_id = 0x22d9;
+  loader.product_id = 0x3869;
+  loader.stored_bin.assign(kErhaiSample512, kErhaiSample512 + 512);
+  loader.stored_bin[50] ^= 0x55;  // Corrupt
+
+  auto res = loader.Load();
+  EXPECT_EQ(res.dl_len, 512);
+  ASSERT_EQ(res.dsc_list.size(), 512u);
+  EXPECT_EQ(0, memcmp(res.dsc_list.data(), loader.stored_bin.data(), 512));
+}
+
+}  // namespace
