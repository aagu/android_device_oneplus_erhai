+std::optional<std::vector<uint8_t>> FixErhaiHogpReport(uint16_t vendor, uint16_t product,
+                                                      const uint8_t* data, size_t size) {
+  if (vendor != kErhaiVendorId || product != kErhaiProductId) {
+    return std::nullopt;
+  }
+
+  if (data == nullptr) {
+    return std::nullopt;
+  }
+
+  // Idempotency: if already 561 bytes, check if it matches header + tail
+  if (size == kRepairedReportLen) {
+    if (std::memcmp(data, kErhaiExpectedHeader, kGattMaxReportLen) == 0 &&
+        std::memcmp(data + kGattMaxReportLen, kErhaiTouchpadTail, kTailLen) == 0) {
+      // Already complete and repaired; do not double fixup.
+      return std::nullopt;
+    }
+    return std::nullopt;
+  }
+
+  // Only fix up exact 512-byte truncated report map
+  if (size != kGattMaxReportLen) {
+    return std::nullopt;
+  }
+
+  // Exact fingerprint check against verified 512-byte descriptor
+  if (std::memcmp(data, kErhaiExpectedHeader, kGattMaxReportLen) != 0) {
+    log::warn("Erhai keyboard VID/PID matched but 512-byte fingerprint did not match verified descriptor");
+    return std::nullopt;
+  }
+
+  // Construct repaired 561-byte descriptor
+  std::vector<uint8_t> repaired;
+  repaired.reserve(kRepairedReportLen);
+  repaired.insert(repaired.end(), data, data + kGattMaxReportLen);
+  repaired.insert(repaired.end(), kErhaiTouchpadTail, kErhaiTouchpadTail + kTailLen);
+
+  log::info("Repaired OnePlus Pad 2 Pro (erhai) keyboard HID report map (512 -> 561 bytes)");
+  return repaired;
+}
+
+}  // namespace bluetooth::device
