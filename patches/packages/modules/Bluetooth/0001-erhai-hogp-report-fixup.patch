+#include <cstdint>
+#include <optional>
+#include <vector>
+
+namespace bluetooth::device {
+
+/**
+ * Checks and repairs truncated HID report map for OnePlus Pad 2 Pro (erhai) keyboard.
+ *
+ * Device VID/PID: 0x22d9 (8921) / 0x3869 (14441).
+ * When size == 512 and the descriptor data matches the verified 512-byte erhai
+ * keyboard report map, appends the missing 49-byte touchpad tail and returns
+ * the repaired 561-byte report map.
+ *
+ * Idempotent: if size == 561 and already contains the 512-byte header + 49-byte tail,
+ * returns std::nullopt (no double fixup needed).
+ * If VID/PID do not match, size is unexpected, data is null, or fingerprint fails to match,
+ * returns std::nullopt.
+ */
+std::optional<std::vector<uint8_t>> FixErhaiHogpReport(uint16_t vendor, uint16_t product,
+                                                      const uint8_t* data, size_t size);
+
+}  // namespace bluetooth::device
